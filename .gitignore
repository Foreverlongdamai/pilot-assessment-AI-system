# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Tooling caches ---
.tools/
node_modules/
src/PilotAssessment.Desktop/Assets/Brand/*-chroma-*.png
.pytest_cache/
.ruff_cache/
.ty/
.coverage
.coverage.*
coverage.xml
htmlcov/

# --- IDE / editor ---
.vscode/
.idea/
.vs/

# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store

# --- Logs, temp, local secrets ---
*.log
*.tmp
.env
.env.*

# --- Future WinUI / .NET frontend build outputs ---
bin/
obj/
*.user
TestResults/
artifacts/
.pilot-assessment-local/

# --- Local session data (NEVER commit real session bundles) ---
# Real bundles contain sensitive biometric data (gaze, EEG, ECG, pilot camera).
# Keep them outside the repo or under local_data/.
local_data/
*.edf
*.parquet
*.mp4
# Synthetic test fixtures are the only allowed exception and must stay synthetic:
!tests/fixtures/**/*.edf
!tests/fixtures/**/*.parquet
!tests/fixtures/**/*.mp4

# --- tmp/: research workspace. Only scripts, notes, design figures and small summaries are tracked ---
# UI build outputs (compiled binaries)
tmp/*-build/
# Downloaded source documents and text extracted from them
tmp/**/review_sources/
tmp/**/txt/
tmp/evidence_design_*/scn*/**/explore/*.txt
# Video frames and screenshots taken from recordings / copies of data (evidence-design workspaces)
tmp/evidence_design_*/scn*/**/*.png
tmp/**/video/
tmp/**/explore/fr*/
tmp/evidence_design_*/scn2/target/*.csv
# Large before/after outputs of QA and audit runs (html, json, screenshots, archives)
tmp/*qa*/**/*.html
tmp/*qa*/**/*.json
tmp/*qa*/**/*.png
tmp/*qa*/**/*.zip
tmp/speed_profile_audit/**/*.html
tmp/speed_profile_audit/**/*.json
tmp/speed_profile_audit/**/*.png
tmp/speed_profile_audit/**/*.svg
tmp/speed_profile_audit/**/*.zip
tmp/temporal_process_qa/**/*.svg
# Before/after copies of demo packages and regenerated outputs inside QA and audit workspaces
tmp/**/before/
tmp/single-method-qa/generated/
# Large study traces
tmp/dual_model_study_*/**/*.csv
# Binaries, archives, documents and logs anywhere under tmp/
tmp/**/*.pdf
tmp/**/*.zip
tmp/**/*.dll
tmp/**/*.pdb
tmp/**/*.exe
tmp/**/*.pri
tmp/**/*.xbf

# --- examples/: only the small scene templates are tracked; the demo packages are regenerated by tools/ ---
examples/*
!examples/scenes/
