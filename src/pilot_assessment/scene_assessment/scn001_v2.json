    {
      "item_id": "A-S2-08",
      "name": "地面起飞",
      "description": "从地面离地，建立初始悬停并控制位置和航向。",
      "checkpoints": [
        {
          "checkpoint_id": "A-S2-08-01",
          "name": "离地并建立初始悬停",
          "description": "直接比较本检查点已整理数据与配置目标；初始悬停保持时长、初始悬停实际高度。",
          "metric_ids": [
            "initial_hover_duration_s",
            "initial_hover_height_m"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-2 (November 2023)",
              "clause": "CP.IV.A.S4/S5",
              "page": "印刷p.18 / PDF第23页",
              "url": "https://www.faa.gov/training_testing/testing/acs/commercial_pl_acs_2.pdf#page=23",
              "support": "官方内容依据",
              "note": "保持机型推荐悬停高度；距表面10 ft以内容差为推荐高度±1/2，超过10 ft为±5 ft，仅在适用条件一致时参考。"
            },
            {
              "document": "SCN-001 项目场景设计",
              "clause": "2026-09-14 原始值、有符号容差与检查点序列",
              "page": "",
              "url": "",
              "support": "项目适配",
              "note": "原始量、坐标分量、期望值、相对D/A区间和时间统计为项目适配；数值默认留空，不执行事件识别。"
            }
          ],
          "fail_when": [
            {
              "metric_id": "initial_hover_duration_s",
              "equals": 0
            }
          ]
        },
        {
          "checkpoint_id": "A-S2-08-02",
          "name": "水平位置控制",
          "description": "直接比较本检查点已整理数据与配置目标；起飞水平位置 X、起飞水平位置 Y。",
          "metric_ids": [
            "takeoff_position_x_m",
            "takeoff_position_y_m"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-2 (November 2023)",
              "clause": "CP.IV.A.S4/S6",
              "page": "印刷p.18 / PDF第23页",
              "url": "https://www.faa.gov/training_testing/testing/acs/commercial_pl_acs_2.pdf#page=23",
              "support": "官方内容依据",
              "note": "支持无漂移上升和指定位置保持；S6位置容差参考±2 ft。"
