{
  "schema_version": "2.0",
  "scene_id": "SCN-001",
  "name": "加速减速任务",
  "description": "按检查点接收已整理的原始数据：完成起飞前检查、地面起飞、加速与保速和急停。系统计算有符号偏差与D/A/U；持续悬停能力留待专门场景。",
  "metrics": [
    {
      "metric_id": "battery_check_completed",
      "name": "电池与供电检查完成",
      "description": "按当前机型检查单完成电池与供电项目。true表示检查已完成，不自动表示设备正常。",
      "unit": "",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "boolean",
      "input_kind": "scalar",
      "comparison": "boolean",
      "shared": false
    },
    {
      "metric_id": "propulsion_check_completed",
      "name": "推进与功率检查完成",
      "description": "按机型检查单完成推进系统与功率相关项目。",
      "unit": "",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "boolean",
      "input_kind": "scalar",
      "comparison": "boolean",
      "shared": false
    },
    {
      "metric_id": "flight_configuration_check_completed",
      "name": "飞控与起飞构型检查完成",
      "description": "按机型检查单完成飞控模式与起飞构型项目。",
      "unit": "",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "boolean",
      "input_kind": "scalar",
      "comparison": "boolean",
      "shared": false
    },
    {
      "metric_id": "flight_instruments_check_completed",
      "name": "飞行仪表检查完成",
      "description": "按机型检查单完成飞行仪表项目。",
      "unit": "",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "boolean",
      "input_kind": "scalar",
      "comparison": "boolean",
      "shared": false
    },
    {
      "metric_id": "alerts_check_completed",
      "name": "告警与系统状态检查完成",
      "description": "按机型检查单完成告警与系统状态项目。",
      "unit": "",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "boolean",
      "input_kind": "scalar",
      "comparison": "boolean",
      "shared": false
    },
    {
      "metric_id": "departure_check_completed",
      "name": "导航与任务信息检查完成",
      "description": "按机型检查单完成导航与任务信息项目。",
      "unit": "",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "boolean",
      "input_kind": "scalar",
      "comparison": "boolean",
      "shared": false
    },
    {
      "metric_id": "initial_hover_duration_s",
      "name": "初始悬停保持时长",
      "description": "已整理的初始悬停实际保持时长，与配置的期望时长比较；本系统不识别保持段。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "scalar",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "initial_hover_height_m",
      "name": "初始悬停实际高度",
      "description": "仅初始悬停检查段的实际高度；与期望高度采用同一高度基准，不含正常离地上升段。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "takeoff_position_x_m",
      "name": "起飞水平位置 X",
      "description": "起飞与初始悬停检查段在场景固定坐标系中的实际 X 坐标；期望值为指定起飞点同系 X 坐标。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "takeoff_position_y_m",
      "name": "起飞水平位置 Y",
      "description": "与 X 同一固定坐标系、同一检查段的实际 Y 坐标；分别比较各轴，不自动合成径向距离。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "takeoff_heading_deg",
      "name": "起飞实际航向",
      "description": "已经整理好的起飞阶段机头航向，使用相同期望航向基准与有符号最短角差。",
      "unit": "deg",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "angle_degrees",
      "shared": false
    },
    {
      "metric_id": "speed_hold_duration_s",
      "name": "指定空速保持时长",
      "description": "已整理的指定空速保持动作持续时间；包含期间偏离，不由本系统切段。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "scalar",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "speed_hold_airspeed_mps",
      "name": "保速阶段实际空速",
      "description": "已整理好的保速检查段实际空速。期望值为本任务指定空速，不含正常加速过程。",
      "unit": "m/s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "air_taxi_height_m",
      "name": "空中滑行实际高度",
      "description": "已整理好的空中滑行高度检查数据；原始高度与期望高度使用同一基准。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "air_taxi_lateral_position_m",
      "name": "空中滑行横向位置坐标",
      "description": "在场景已约定的固定走廊坐标系中的实际横向坐标；期望值为走廊中心坐标，本系统不投影或截取轨迹。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "air_taxi_heading_deg",
      "name": "空中滑行实际航向",
      "description": "只含该检查点已整理好的空中滑行机头航向；不是急停航向，也不是地面航迹角。",
      "unit": "deg",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "angle_degrees",
      "shared": false
    },
    {
      "metric_id": "deceleration_started",
      "name": "本次减速操纵已执行",
      "description": "由本检查点提供的动作完成事实，本系统不识别减速起点。",
      "unit": "",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "boolean",
      "input_kind": "scalar",
      "comparison": "boolean",
      "shared": false
    },
    {
      "metric_id": "deceleration_onset_position_m",
      "name": "减速起动实际位置坐标",
      "description": "由检查点数据提供的减速起动沿向坐标，与配置的提示位置坐标比较；不是预计算偏差。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "scalar",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "quickstop_entry_airspeed_mps",
      "name": "急停入口实际空速",
      "description": "由已整理急停检查点提供的入口空速，与指定入口空速比较；系统不重新识别入口时刻。",
      "unit": "m/s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "scalar",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "stop_achieved",
      "name": "本次急停停止结果",
      "description": "由急停检查点提供的停止事实；不能仅因数据包标为急停而补成true，本系统不检测停止事件。",
      "unit": "",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "boolean",
      "input_kind": "scalar",
      "comparison": "boolean",
      "shared": false
    },
    {
      "metric_id": "deceleration_duration_s",
      "name": "本次减速实际耗时",
      "description": "已整理检查点提供的实际减速耗时，与配置期望耗时比较；不在系统中识别起止事件。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "scalar",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "quickstop_height_m",
      "name": "急停实际高度",
      "description": "已整理好的急停阶段实际高度，包含末端，与配置的同基准高度比较。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "quickstop_heading_deg",
      "name": "急停实际航向",
      "description": "已整理好的急停阶段机头航向，包含末端；独立于空中滑行航向检查。",
      "unit": "deg",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "angle_degrees",
      "shared": false
    },
    {
      "metric_id": "quickstop_lateral_position_m",
      "name": "急停横向位置坐标",
      "description": "急停阶段场景固定走廊坐标系中的实际横向坐标，包含末端；本系统不截取或投影轨迹。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "relative",
      "input_kind": "series",
      "comparison": "linear",
      "shared": false
    },
    {
      "metric_id": "quickstop_prohibited_event_count",
      "name": "已认定的禁止事件数量",
      "description": "本检查点已提供的禁止事件计数，0次为D，非0为U；普通D/A超差不在此重复计为禁止事件。",
      "unit": "",
      "value_type": "integer",
      "rule": "zero_events",
      "parameter_kind": "integer",
      "input_kind": "scalar",
      "comparison": "count",
      "shared": false
    }
  ],
  "items": [
    {
