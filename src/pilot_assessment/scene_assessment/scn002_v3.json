  "items": [
    {
      "item_id": "A-S2-02",
      "name": "定点悬停保持",
      "description": "四次悬停共用水平位置、悬停高度、航向和激光四个检查点，作为同一个item评价。水平位置与高度分别设置容差；vx/vy归水平位置、vz归高度，作为稳定性补充。每帧包含当前环节的原始高度及其他指标，不从数据识别环节或补值。",
      "assessment_kind": "flight",
      "phases": [
        {
          "phase_id": "lower_1",
          "name": "下方第一次悬停",
          "single_frame": false,
          "required_duration_s": 5
        },
        {
          "phase_id": "upper_1",
          "name": "上方第一次悬停",
          "single_frame": false,
          "required_duration_s": 5
        },
        {
          "phase_id": "lower_2",
          "name": "下方第二次悬停",
          "single_frame": false,
          "required_duration_s": 5
        },
        {
          "phase_id": "upper_2",
          "name": "上方第二次悬停",
          "single_frame": false,
          "required_duration_s": 5
        }
      ],
      "checkpoints": [
        {
          "checkpoint_id": "A-S2-02-01",
          "name": "水平位置保持",
          "description": "分别比较实际X、Y与目标水平位置；水平速度分量作为稳定性补充。各指标独立设置D/A容差，逐帧取最差档位；不包含高度、不计算XYZ统一距离。",
          "metric_ids": [
            "hover_x_m",
            "hover_y_m",
            "hover_vx_mps",
            "hover_vy_mps"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-2",
              "clause": "CP.IV.A.S6",
              "page": "PDF第23页",
              "url": "https://www.faa.gov/training_testing/testing/acs/commercial_pl_acs_2.pdf#page=23",
              "support": "官方内容依据／项目适配",
              "note": "官方支持保持指定点附近的位置；X/Y分量、各自D/A容差与逐帧汇总为项目适配。"
            },
            {
              "document": "项目场景设计",
              "clause": "2026-09-15 悬停item合并",
              "page": "",
              "url": "",
              "support": "项目定义",
              "note": "水平速度vx/vy补充描述定点稳定性；其近零阈值及与位置取最差档位的规则并非FAA给定。"
            },
            {
              "document": "EASA Flight Examiner Manual Module 3.3 CPL(H)",
              "clause": "Section 2(c); Section 2 Skill",
              "page": "第10、20页",
              "url": "https://www.easa.europa.eu/en/downloads/138658/en",
              "support": "直升机操纵内容参考／项目适配",
              "note": "V2023.1将定点悬停列为一个考核条目，并要求保持航向、高度和地面位置；不是eVTOL专用标准，也未规定本系统的D/A、速度阈值或CPT。"
            },
            {
              "document": "UK CAA Standards Document 03(H) V6",
              "clause": "Appendix 1 Section 2(c)",
              "page": "第18页",
              "url": "https://www.caa.co.uk/publication/download/12966#page=18",
              "support": "直升机操纵内容参考／项目适配",
              "note": "在迎风、侧风、顺风条件下的定点悬停条目内，同时保持航向、高度和地面位置；本场景没有覆盖完整CPL(H)考核。"
            }
          ],
          "fail_when": []
        },
        {
          "checkpoint_id": "A-S2-02-04",
          "name": "悬停高度保持",
          "description": "按当前已标明的下方或上方悬停环节，将实际高度与对应目标高度比较；垂直速度作为稳定性补充。各指标分别使用自己的D/A容差，逐帧取最差档位；垂直速度接近零不能代替正确高度。",
