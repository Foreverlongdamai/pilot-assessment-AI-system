    {
      "item_id": "A-S2-05",
      "name": "空中滑行（加速与保速）",
      "description": "加速及保速各阶段已由输入标明；空速沿同一条相对加速首帧计时的参考曲线逐帧评价，同时检查高度、航迹和航向。实际数据须覆盖参考曲线末端。",
      "assessment_kind": "flight",
      "phases": [
        {
          "phase_id": "acceleration",
          "name": "加速",
          "single_frame": false,
          "required_duration_s": null,
          "minimum_frame_count": 2
        },
        {
          "phase_id": "hold",
          "name": "保速",
          "single_frame": false,
          "required_duration_s": null,
          "minimum_frame_count": 2
        }
      ],
      "checkpoints": [
        {
          "checkpoint_id": "A-S2-05-01",
          "name": "加速与保速速度控制",
          "description": "从 acceleration 首帧作为 0 秒，按真实时间差逐帧线性插值同一条参考速度曲线；以原始空速减参考空速分档。缺少起点、参考越界或输入未覆盖参考末端时不能完整评估。",
          "metric_ids": [
            "air_taxi_airspeed_mps"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-17",
              "clause": "AP.II.E.S4/S5/S6",
              "page": "印刷p14／PDF19",
              "url": "https://www.faa.gov/training_testing/testing/acs/atp_pl_acs_17.pdf#page=19",
              "support": "官方内容依据／项目适配",
              "note": "官方支持安全速度选择及指定空速、高度与航迹保持；逐秒加速参考曲线、任务时长和D/A容差为项目训练目标，不是官方通用时间曲线。"
            }
          ],
          "fail_when": []
        },
        {
          "checkpoint_id": "A-S2-05-02",
          "name": "高度保持",
          "description": "高度保持",
          "metric_ids": [
            "air_taxi_height_m"
          ],
          "sources": [
            {
