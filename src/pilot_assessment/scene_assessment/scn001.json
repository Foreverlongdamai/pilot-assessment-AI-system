          "fail_when": []
        },
        {
          "checkpoint_id": "A-S1-06-03",
          "name": "飞控与起飞构型区",
          "description": "检查飞控模式及起飞构型信息区域停留时间。",
          "metric_ids": [
            "flight_mode_configuration"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-17 (November 2023)",
              "clause": "AP.I.A.K13; AP.II.F.S1/S4",
              "page": "印刷p.2、15 / PDF第7、20页",
              "url": "https://www.faa.gov/training_testing/testing/acs/atp_pl_acs_17.pdf#page=20",
              "support": "官方内容依据",
              "note": "支持飞控与起飞构型检查内容。"
