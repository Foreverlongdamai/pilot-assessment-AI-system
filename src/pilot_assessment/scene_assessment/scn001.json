    },
    {
      "item_id": "A-S2-08",
      "name": "地面起飞",
      "description": "从地面离地，建立初始悬停并控制位置和航向。",
      "checkpoints": [
        {
          "checkpoint_id": "A-S2-08-01",
          "name": "离地并建立初始悬停",
          "description": "检查初始保持时长和保持期间高度。",
          "metric_ids": [
            "initial_hover_duration_s",
            "initial_hover_max_height_error_m"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-2 (November 2023)",
              "clause": "CP.IV.A.S4/S5",
              "page": "印刷p.18 / PDF第23页",
              "url": "https://www.faa.gov/training_testing/testing/acs/commercial_pl_acs_2.pdf#page=23",
              "support": "官方内容依据",
              "note": "保持机型推荐悬停高度；距表面10 ft以内容差为推荐高度±1/2，超过10 ft为±5 ft，仅在适用条件一致时参考。"
            },
            {
              "document": "SCN-001 项目场景设计",
              "clause": "2026-09-07 六item方法",
              "page": "",
              "url": "",
              "support": "项目适配",
              "note": "初始保持秒数及最大偏差分档是项目计算方法，参数手填。"
            }
          ],
          "fail_when": [
            {
              "metric_id": "initial_hover_duration_s",
              "equals": 0
            }
          ]
        },
        {
          "checkpoint_id": "A-S2-08-02",
          "name": "水平位置控制",
          "description": "检查离地和初始悬停期间的水平偏移。",
          "metric_ids": [
            "takeoff_max_horizontal_displacement_m"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-2 (November 2023)",
              "clause": "CP.IV.A.S4/S6",
              "page": "印刷p.18 / PDF第23页",
              "url": "https://www.faa.gov/training_testing/testing/acs/commercial_pl_acs_2.pdf#page=23",
              "support": "官方内容依据",
              "note": "支持无漂移上升和指定位置保持；S6位置容差参考±2 ft。"
            },
            {
              "document": "SCN-001 项目场景设计",
              "clause": "2026-09-07 六item方法",
              "page": "",
              "url": "",
              "support": "项目适配",
              "note": "最大水平位移和D/A区间为本项目适配。"
            }
          ],
          "fail_when": []
        },
        {
          "checkpoint_id": "A-S2-08-03",
          "name": "航向保持",
          "description": "检查起飞过程中的机头航向。",
          "metric_ids": [
