        {
          "checkpoint_id": "A-S1-06-06",
          "name": "导航与任务信息区",
          "description": "检查导航及指定任务信息区域停留时间。",
          "metric_ids": [
            "departure_navigation"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-17 (November 2023)",
              "clause": "AP.II.F.S4",
              "page": "印刷p.15 / PDF第20页",
