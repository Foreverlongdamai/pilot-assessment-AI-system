{
  "schema_version": "1.0",
  "scene_id": "SCN-001",
  "name": "加速减速任务",
  "description": "从起飞前检查开始，经地面起飞、加速与保速、急停，完成末端悬停。直接使用已计算结果评价六个item。",
  "metrics": [
    {
      "metric_id": "energy_electrical",
      "name": "电池与供电区停留时间",
      "description": "起飞前在电池电量、剩余能量、温度及供电状态信息区域停留的秒数。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "gaze",
      "shared": false
    },
    {
      "metric_id": "propulsion_power",
      "name": "推进与功率区停留时间",
      "description": "起飞前在电机、推进系统、可用功率或推力信息区域停留的秒数。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "gaze",
      "shared": false
    },
    {
      "metric_id": "flight_mode_configuration",
      "name": "飞控与起飞构型区停留时间",
      "description": "起飞前在飞控模式、起飞设置、自动化与适用构型信息区域停留的秒数。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "gaze",
      "shared": false
    },
    {
      "metric_id": "flight_state",
      "name": "主要飞行仪表区停留时间",
      "description": "起飞前在姿态、高度、空速、垂直速度及航向信息区域停留的秒数。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "gaze",
      "shared": false
    },
    {
      "metric_id": "alerts_readiness",
      "name": "告警与系统状态区停留时间",
      "description": "起飞前在警告、注意及系统状态摘要信息区域停留的秒数。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "gaze",
      "shared": false
    },
    {
      "metric_id": "departure_navigation",
      "name": "导航与任务信息区停留时间",
      "description": "起飞前在指定方向、路径、任务目标及适用导航通信信息区域停留的秒数。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "gaze",
      "shared": false
    },
    {
      "metric_id": "initial_hover_duration_s",
      "name": "初始悬停保持时长",
      "description": "离地后实际执行初始悬停动作的持续时间，包含期间偏离。明确未执行为0，缺失不等于0。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "hold",
      "shared": false
    },
    {
      "metric_id": "initial_hover_max_height_error_m",
      "name": "初始悬停最大高度偏差",
      "description": "仅初始悬停保持期间相对指定高度的最大绝对偏差，不把正常离地上升过程算作高度错误。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "takeoff_max_horizontal_displacement_m",
      "name": "起飞最大水平位移",
      "description": "起飞与初始悬停期间相对指定起飞位置的最大水平位移。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "takeoff_max_heading_error_deg",
      "name": "起飞最大航向偏差",
      "description": "起飞与初始悬停期间机头相对指定航向的最大绝对偏差，已处理角度跨界。",
      "unit": "deg",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "speed_hold_duration_s",
      "name": "保速动作时长",
      "description": "达到指定空速后实际执行保速动作的持续时间，包含偏离；不是只累计D/A时间。未保速或仅瞬间达到为0。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "hold",
      "shared": false
    },
    {
      "metric_id": "speed_hold_max_airspeed_error_mps",
      "name": "保速最大空速偏差",
      "description": "同一次保速动作中相对指定空速的最大绝对偏差，不包括正常加速过程；空速制式与场景目标一致。",
      "unit": "m/s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "air_taxi_max_height_error_m",
      "name": "空中滑行最大高度偏差",
      "description": "加速及保速全过程相对指定任务高度的最大绝对偏差。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "air_taxi_max_cross_track_error_m",
      "name": "空中滑行最大横向偏差",
      "description": "加速及保速全过程相对走廊中心线的最大横向绝对偏差。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "air_taxi_max_heading_error_deg",
      "name": "空中滑行最大航向偏差",
      "description": "加速及保速全过程机头相对指定航向的最大绝对偏差；不是地面航迹方向。",
      "unit": "deg",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "deceleration_started",
      "name": "已开始减速操纵",
      "description": "已检测到开始减速操纵的事实，不能用机体响应起动时刻代替。",
      "unit": "—",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "fact",
      "shared": false
    },
    {
      "metric_id": "deceleration_onset_position_error_m",
      "name": "减速起动位置偏差",
      "description": "开始减速操纵时相对提示线的有符号距离；负值表示提前，正值表示滞后。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "signed",
      "shared": false
    },
    {
      "metric_id": "quickstop_entry_airspeed_error_mps",
      "name": "减速入口空速偏差",
      "description": "开始减速操纵时相对指定入口空速的绝对偏差，与前一item采用相同空速制式。",
      "unit": "m/s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "stop_achieved",
      "name": "已停止水平运动",
      "description": "已停止相对地面水平运动的事实；不是空速为0，不要求位置、高度或保持时长已达标。",
      "unit": "—",
      "value_type": "boolean",
      "rule": "must_be_true",
      "parameter_kind": "fact",
      "shared": false
    },
    {
      "metric_id": "deceleration_duration_s",
      "name": "减速耗时",
      "description": "从开始减速操纵到停止水平运动的耗时，不含此前保速或之后悬停。性能参考对应本次机型、构型、载荷、风况及进入条件。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "duration",
      "shared": false
    },
    {
      "metric_id": "quickstop_max_height_error_m",
      "name": "减速最大高度偏差",
      "description": "本次减速期间相对指定任务高度的最大绝对偏差。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "quickstop_max_heading_error_deg",
      "name": "减速最大航向偏差",
      "description": "本次减速期间机头相对指定航向的最大绝对偏差，已处理角度跨界。",
      "unit": "deg",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "quickstop_max_cross_track_error_m",
      "name": "减速最大横向偏差",
      "description": "本次减速期间相对走廊中心线的最大横向绝对偏差。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "quickstop_prohibited_event_count",
      "name": "减速禁止事件数",
      "description": "已按机型限制或场景规则认定的禁止超限或禁止接触事件数；普通D/A超差不重复计入，许可短时功率不视作违规。",
      "unit": "次",
      "value_type": "integer",
      "rule": "zero_events",
      "parameter_kind": "fact",
      "shared": false
    },
    {
      "metric_id": "terminal_hover_duration_s",
      "name": "末端悬停保持时长",
      "description": "末端实际保持动作的持续时间，包含期间位置和高度偏离。定点与高度两个item共用同一个值及D/A参数；未执行为0。",
      "unit": "s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "hold",
      "shared": true
    },
    {
      "metric_id": "terminal_max_horizontal_position_error_m",
      "name": "末端最大水平位置偏差",
      "description": "同一次末端保持期间相对指定目标点的最大水平距离；不得把实际停错的位置改作目标。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "terminal_max_horizontal_groundspeed_mps",
      "name": "末端最大水平地速",
      "description": "同一次末端保持期间水平地速的最大值，表示保持时还在多快地水平移动；不是空速。",
      "unit": "m/s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "terminal_max_heading_error_deg",
      "name": "末端最大航向偏差",
      "description": "同一次末端保持期间机头相对指定航向的最大绝对偏差。",
      "unit": "deg",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "terminal_max_height_error_m",
      "name": "末端最大高度偏差",
      "description": "同一次末端保持期间相对指定目标高度的最大绝对偏差，包含开始保持时已经存在的高度错误。",
      "unit": "m",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    },
    {
      "metric_id": "terminal_max_abs_vertical_speed_mps",
      "name": "末端最大垂直速度",
      "description": "同一次末端保持期间垂直速度绝对值的最大值，表示升降运动大小。",
      "unit": "m/s",
      "value_type": "number",
      "rule": "interval",
      "parameter_kind": "error",
      "shared": false
    }
  ],
  "items": [
    {
      "item_id": "A-S1-06",
      "name": "起飞前检查",
      "description": "按起飞前六类仪表区域的停留时间检查注视覆盖。",
      "checkpoints": [
        {
          "checkpoint_id": "A-S1-06-01",
          "name": "电池与供电区",
          "description": "检查是否在规定区域停留符合配置要求的时间。",
          "metric_ids": [
            "energy_electrical"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-17 (November 2023)",
              "clause": "AP.I.A.K5/K8; AP.II.F.S3",
              "page": "印刷p.2、15 / PDF第7、20页",
              "url": "https://www.faa.gov/training_testing/testing/acs/atp_pl_acs_17.pdf#page=20",
              "support": "官方内容依据",
              "note": "支持电池、电气与系统状态信息内容，未规定注视秒数。"
            },
            {
              "document": "SCN-001 项目场景设计",
              "clause": "2026-09-07 六item方法",
              "page": "",
              "url": "",
              "support": "项目适配",
              "note": "区域划分、停留时长及D/A分界属于项目人因参数。"
            }
          ],
          "fail_when": []
        },
        {
          "checkpoint_id": "A-S1-06-02",
          "name": "推进与功率区",
          "description": "检查推进与功率信息区域停留时间。",
          "metric_ids": [
            "propulsion_power"
          ],
          "sources": [
            {
              "document": "FAA-S-ACS-17 (November 2023)",
              "clause": "AP.I.A.K2/K3; AP.II.F.S1/S3",
              "page": "印刷p.2、15 / PDF第7、20页",
              "url": "https://www.faa.gov/training_testing/testing/acs/atp_pl_acs_17.pdf#page=20",
              "support": "官方内容依据",
              "note": "支持推进系统和功率检查内容，未规定注视秒数。"
            },
            {
              "document": "SCN-001 项目场景设计",
              "clause": "2026-09-07 六item方法",
              "page": "",
              "url": "",
              "support": "项目适配",
              "note": "本项只评价区域停留时间，不验证读数理解或故障处置。"
            }
